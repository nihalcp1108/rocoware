# Server Port (Railway automatically sets PORT)
PORT=5002
NODE_ENV=development

# MongoDB Atlas Connection String
# Example: mongodb+srv://USERNAME:PASSWORD@cluster0.xxx.mongodb.net/rocoware?retryWrites=true&w=majority
MONGO_URI=

# JWT Secrets
JWT_SECRET=super_secret_complaint_portal_jwt_key_2026_secure_random
JWT_EXPIRES_IN=7d

# Allowed Frontend Origins for CORS (e.g. Vercel deployment URL)
CLIENT_URL=http://localhost:5173
FRONTEND_URL=https://your-vercel-app.vercel.app

# Cloudinary Integration (Optional: falls back to local file storage if left empty)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
